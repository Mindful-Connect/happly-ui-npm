{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/happly-ui-components.json",
  "title": "HapplyUI Components Configuration",
  "description": "Configuration file for HapplyUI components in your project",
  "type": "object",
  "required": ["tailwind", "tsx", "aliases"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for validation and IDE support"
    },
    "tailwind": {
      "type": "object",
      "description": "Tailwind CSS configuration",
      "required": ["config", "css"],
      "properties": {
        "config": {
          "type": "string",
          "description": "Path to your Tailwind config file",
          "examples": ["tailwind.config.ts", "tailwind.config.js"]
        },
        "css": {
          "type": "string",
          "description": "Path to your global CSS file",
          "examples": ["src/index.css", "app/globals.css"]
        },
        "prefix": {
          "type": "string",
          "description": "Optional prefix for Tailwind classes"
        }
      },
      "additionalProperties": false
    },
    "tsx": {
      "type": "boolean",
      "description": "Whether to use TypeScript (.tsx) or JavaScript (.jsx) for components",
      "default": true
    },
    "aliases": {
      "type": "object",
      "description": "Import path aliases for your project",
      "required": ["components", "utils", "ui"],
      "properties": {
        "components": {
          "type": "string",
          "description": "Alias for the components directory",
          "default": "@/components",
          "examples": ["@/components", "~/components"]
        },
        "utils": {
          "type": "string",
          "description": "Alias for the utils file (cn function)",
          "default": "@/lib/happly-ui-utils",
          "examples": ["@/lib/happly-ui-utils", "~/lib/happly-ui-utils"]
        },
        "ui": {
          "type": "string",
          "description": "Alias for the UI components directory",
          "default": "@/components/ui",
          "examples": ["@/components/ui", "~/components/ui"]
        },
        "hooks": {
          "type": "string",
          "description": "Alias for custom hooks directory",
          "default": "@/hooks",
          "examples": ["@/hooks", "~/hooks"]
        },
        "lib": {
          "type": "string",
          "description": "Alias for the lib directory",
          "default": "@/lib",
          "examples": ["@/lib", "~/lib"]
        }
      },
      "additionalProperties": false
    },
    "registry": {
      "type": "string",
      "description": "Custom registry URL (defaults to HapplyUI registry)",
      "format": "uri"
    }
  },
  "additionalProperties": false
}
