{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/components/ui/*": ["./packages/registry/ui/*"],
      "@/lib/*": ["./packages/registry/lib/*"],
      "@/*": ["./packages/registry/*"]
    },
    "jsx": "react-jsx"
  },
  "exclude": ["node_modules", "dist", "docs", "packages/cli"]
}
