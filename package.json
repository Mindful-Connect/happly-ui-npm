{
  "name": "happly-ui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' dev",
    "build:registry": "bun run scripts/build-registry.ts && bun run scripts/build-tailwind-plugin.ts && bun run scripts/sync-theme-templates.ts",
    "sync:theme": "bun run scripts/sync-theme-templates.ts",
    "showcase:page": "bun run scripts/build-showcase-page.ts",
    "clean": "rm -rf packages/*/dist packages/*/.turbo",
    "lint": "eslint .",
    "storybook": "bun run --cwd packages/registry storybook",
    "build-storybook": "bun run --cwd packages/registry build-storybook",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@googlemaps/js-api-loader": "^1.16.2",
    "@headlessui/react": "^1.7.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@storybook/react": "^10.2.14",
    "@storybook/react-vite": "^10.2.14",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "latest",
    "@types/google.maps": "^3.58.1",
    "@types/marked": "^6.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/react": "^5.2.0",
    "@uppy/xhr-upload": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colord": "^2.9.3",
    "dompurify": "^3.4.14",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "libphonenumber-js": "^1.12.37",
    "lucide-react": "^0.574.0",
    "marked": "^17.0.4",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-international-phone": "^4.7.0",
    "storybook": "^10.2.14",
    "tailwind-merge": "^2.2.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "use-debounce": "^10.1.0",
    "zod": "^3.25.56"
  },
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "react-hook-form": "^7.71.2"
  }
}
