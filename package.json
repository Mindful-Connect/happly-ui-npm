{
  "name": "happly-ui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' dev",
    "build:registry": "bun run scripts/build-registry.ts",
    "clean": "rm -rf packages/*/dist packages/*/.turbo"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.7.0"
  },
  "module": "index.ts",
  "type": "module"
}
