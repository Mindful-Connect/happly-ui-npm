{
  "name": "happly-ui",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' dev",
    "build:registry": "bun run scripts/build-registry.ts",
    "clean": "rm -rf packages/*/dist packages/*/.turbo",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.0.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0"
  },
  "module": "index.ts",
  "type": "module"
}
