# @mindful-connect packages live on GitHub Packages, not the public npm registry.
# Local installs authenticate with your GitHub token (needs read:packages):
#   export NODE_AUTH_TOKEN=$(gh auth token)
# CI sets NODE_AUTH_TOKEN from its own GITHUB_TOKEN.
@mindful-connect:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
