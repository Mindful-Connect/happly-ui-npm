{
  "compilerOptions": {
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": ["../packages/registry/ui/*"],
      "@/lib/happly-ui-utils": ["../packages/registry/lib/happly-ui-utils"],
      "@/lib/tv": ["../packages/registry/lib/tv"],
      "@/lib/polymorphic": ["../packages/registry/lib/polymorphic"],
      "@/lib/recursive-clone-children": ["../packages/registry/lib/recursive-clone-children"],
      "@/lib/alert-utils": ["../packages/registry/lib/alert-utils"],
      "@/lib/tag-utils": ["../packages/registry/lib/tag-utils"],
      "@/lib/currency-input-utils": ["../packages/registry/lib/currency-input-utils"],
      "@/lib/memoji": ["../packages/registry/lib/memoji"],
      "@/lib/form-field-context": ["../packages/registry/lib/form-field-context"],
      "@/hooks/*": ["../packages/registry/hooks/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
