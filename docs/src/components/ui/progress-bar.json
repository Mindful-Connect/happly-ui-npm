{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "progress-bar",
  "type": "registry:ui",
  "title": "Progress Bar",
  "description": "A progress bar component indicating the completion status of a task.",
  "dependencies": ["class-variance-authority"],
  "registryDependencies": ["happly-ui-utils"],
  "docs": {
    "lead": "A progress bar component to show the completion status of a task or process, with neutral and primary color variants.",
    "usage": "import { ProgressBar } from \"@/components/happly-ui/progress-bar\"\n\n<ProgressBar variant=\"primary\" progress={50} />",
    "examples": [
      {
        "title": "Default",
        "description": "The default neutral progress bar.",
        "code": "<ProgressBar variant=\"neutral\" progress={45} />",
        "preview": [
          {
            "component": "progress-bar",
            "props": {
              "variant": "neutral",
              "progress": 45
            }
          }
        ]
      },
      {
        "title": "Primary Variant",
        "description": "Progress bar using the primary brand color.",
        "code": "<ProgressBar variant=\"primary\" progress={75} />",
        "preview": [
          {
            "component": "progress-bar",
            "props": {
              "variant": "primary",
              "progress": 75
            }
          }
        ]
      }
    ],
    "api": [
      {
        "name": "ProgressBar",
        "description": "The main component for progress indication.",
        "props": [
          {
            "name": "variant",
            "type": "'neutral' | 'primary'",
            "default": "'neutral'",
            "description": "The visual color variant of the progress bar."
          },
          {
            "name": "progress",
            "type": "number",
            "default": "0",
            "description": "The current progress value, from 0 to 100."
          }
        ]
      }
    ],
    "files": [
      {
        "path": "ui/progress-bar.tsx",
        "type": "registry:ui"
      }
    ]
  },
  "files": [
    {
      "path": "ui/progress-bar.tsx",
      "type": "registry:ui"
    }
  ]
}
