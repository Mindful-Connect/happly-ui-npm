{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "searchable-combo-box",
  "type": "registry:ui",
  "title": "Searchable Combo Box",
  "description": "A searchable multi-select combobox component with tag selection.",
  "dependencies": ["lucide-react"],
  "registryDependencies": [
    "command",
    "custom-input-wrapper",
    "popover",
    "tag",
    "happly-ui-utils"
  ],
  "docs": {
    "lead": "A powerful searchable multi-select combobox component for selecting and managing multiple tags or options.",
    "usage": "import { SearchableMultiCombobox } from \"@/components/ui/searchable-combo-box\"\nimport { useTags } from \"@/hooks/use-tags\"\n\n<SearchableMultiCombobox\n  selected={selectedTags}\n  setSelected={setSelectedTags}\n  tag=\"sector\"\n  useTags={useTags}\n  t={t}\n/>",
    "examples": [
      {
        "title": "Default",
        "description": "Basic searchable multi-combobox.",
        "code": "<SearchableMultiCombobox\n  selected={selected}\n  setSelected={setSelected}\n  tag=\"sector\"\n  useTags={useTags}\n  t={t}\n/>",
        "preview": [
          {
            "component": "searchable-combo-box",
            "props": {},
            "children": ""
          }
        ]
      }
    ],
    "api": [
      {
        "name": "SearchableMultiCombobox",
        "description": "The main searchable multi-combobox component.",
        "props": [
          {
            "name": "selected",
            "type": "Tag[]",
            "description": "Array of selected tags."
          },
          {
            "name": "setSelected",
            "type": "(tags: Tag[]) => void",
            "description": "Callback to update selected tags."
          },
          {
            "name": "tag",
            "type": "TagCategory",
            "description": "The category of tags to search."
          },
          {
            "name": "useTags",
            "type": "Function",
            "description": "Hook to fetch tags."
          },
          {
            "name": "t",
            "type": "any",
            "description": "Translation function."
          },
          {
            "name": "allowAdding",
            "type": "boolean",
            "default": "false",
            "description": "Allow adding custom options."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/searchable-combo-box.tsx",
      "type": "registry:ui"
    },
    {
      "path": "lib/searchable-combo-box-utils.ts",
      "type": "registry:lib"
    }
  ]
}
