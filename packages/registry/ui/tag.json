{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "tag",
  "type": "registry:ui",
  "title": "Tag",
  "description": "A tag component for labeling and categorization.",
  "dependencies": [
    "@radix-ui/react-slot",
    "class-variance-authority",
    "react-icons"
  ],
  "registryDependencies": [
    "utils"
  ],
  "docs": {
    "lead": "A tag component for labeling and categorization.",
    "usage": "import { Tag, TagIcon, TagClose } from \"@/components/ui/tag\"\n\n<Tag variant=\"stroke\">\n  <TagIcon><Icon /></TagIcon>\n  Label\n  <TagClose />\n</Tag>",
    "examples": [
      {
        "title": "Default",
        "description": "Default tag variant.",
        "code": "<Tag variant=\"stroke\">Tag Label</Tag>",
        "preview": [
          {
            "component": "tag",
            "props": {
              "variant": "stroke"
            },
            "children": "Tag Label"
          }
        ]
      },
      {
        "title": "Gray Variant",
        "description": "Gray background variant.",
        "code": "<Tag variant=\"gray\">Gray Tag</Tag>",
        "preview": [
          {
            "component": "tag",
            "props": {
              "variant": "gray"
            },
            "children": "Gray Tag"
          }
        ]
      }
    ],
    "api": [
      {
        "name": "Tag",
        "description": "The main Tag component.",
        "props": [
          {
            "name": "variant",
            "type": "'stroke' | 'gray'",
            "default": "'stroke'",
            "description": "The visual style of the tag."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Whether the tag is disabled."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/tag.tsx",
      "type": "registry:ui"
    },
    {
      "path": "lib/tag-utils.ts",
      "type": "registry:lib"
    }
  ]
}
