{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "button",
  "type": "registry:ui",
  "title": "Button",
  "description": "A button component with multiple variants, modes, and sizes. Use namespace import: import { Button } from '@/components/ui/button'. Supports new variant system.",
  "dependencies": [
    "@radix-ui/react-slot",
    "tailwind-variants",
    "colord",
    "react-icons"
  ],
  "registryDependencies": [
    "tv",
    "polymorphic",
    "recursive-clone-children",
    "happly-ui-utils"
  ],
  "docs": {
    "lead": "A compound button component with variants, modes, sizes, and icon support.",
    "usage": "import { Button } from \"@/components/ui/button\"\n\n<Button variant=\"primary\" mode=\"filled\">\n  Click me\n</Button>",
    "examples": [
      {
        "title": "Primary Variant",
        "description": "The primary variant uses the brand color for main call-to-action buttons.",
        "code": "<Button variant=\"primary\" mode=\"filled\">Filled</Button>\n<Button variant=\"primary\" mode=\"stroke\">Stroke</Button>\n<Button variant=\"primary\" mode=\"lighter\">Lighter</Button>\n<Button variant=\"primary\" mode=\"ghost\">Ghost</Button>",
        "preview": [
