{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "button",
  "type": "registry:ui",
  "title": "Button",
  "description": "A button component with multiple variants, modes, and sizes. Use namespace import: import * as Button from '@/components/ui/button'. Supports compound component API (Button.Root, Button.Icon) and legacy shadcn/ui API.",
  "dependencies": [
    "@radix-ui/react-slot",
    "tailwind-variants"
  ],
  "registryDependencies": [
    "tv",
    "polymorphic",
    "recursive-clone-children"
  ],
  "docs": {
    "lead": "A compound button component with variants, modes, sizes, and icon support.",
    "usage": "import * as Button from \"@/components/ui/button\"\n\n<Button.Root variant=\"primary\" mode=\"filled\">\n  Click me\n</Button.Root>",
    "examples": [
      {
        "title": "Primary Variant",
        "description": "The primary variant uses the brand color for main call-to-action buttons.",
        "code": "<Button.Root variant=\"primary\" mode=\"filled\">Filled</Button.Root>\n<Button.Root variant=\"primary\" mode=\"stroke\">Stroke</Button.Root>\n<Button.Root variant=\"primary\" mode=\"lighter\">Lighter</Button.Root>\n<Button.Root variant=\"primary\" mode=\"ghost\">Ghost</Button.Root>",
        "preview": [
          {
            "component": "button",
            "props": {
              "variant": "primary",
              "mode": "filled"
            },
            "children": "Filled"
          },
          {
            "component": "button",
            "props": {
              "variant": "primary",
              "mode": "stroke"
            },
            "children": "Stroke"
          },
          {
            "component": "button",
            "props": {
              "variant": "primary",
              "mode": "lighter"
            },
            "children": "Lighter"
          },
          {
            "component": "button",
            "props": {
              "variant": "primary",
              "mode": "ghost"
            },
            "children": "Ghost"
          }
        ]
      },
      {
        "title": "Neutral Variant",
        "description": "The neutral variant uses grayscale colors for secondary actions.",
        "code": "<Button.Root variant=\"neutral\" mode=\"filled\">Filled</Button.Root>\n<Button.Root variant=\"neutral\" mode=\"stroke\">Stroke</Button.Root>\n<Button.Root variant=\"neutral\" mode=\"lighter\">Lighter</Button.Root>\n<Button.Root variant=\"neutral\" mode=\"ghost\">Ghost</Button.Root>",
        "preview": [
          {
            "component": "button",
            "props": {
              "variant": "neutral",
              "mode": "filled"
            },
            "children": "Filled"
          },
          {
            "component": "button",
            "props": {
              "variant": "neutral",
              "mode": "stroke"
            },
            "children": "Stroke"
          },
          {
            "component": "button",
            "props": {
              "variant": "neutral",
              "mode": "lighter"
            },
            "children": "Lighter"
          },
          {
            "component": "button",
            "props": {
              "variant": "neutral",
              "mode": "ghost"
            },
            "children": "Ghost"
          }
        ]
      },
      {
        "title": "Error Variant",
        "description": "The error variant for destructive actions.",
        "code": "<Button.Root variant=\"error\" mode=\"filled\">Filled</Button.Root>\n<Button.Root variant=\"error\" mode=\"stroke\">Stroke</Button.Root>\n<Button.Root variant=\"error\" mode=\"lighter\">Lighter</Button.Root>\n<Button.Root variant=\"error\" mode=\"ghost\">Ghost</Button.Root>",
        "preview": [
          {
            "component": "button",
            "props": {
              "variant": "error",
              "mode": "filled"
            },
            "children": "Filled"
          },
          {
            "component": "button",
            "props": {
              "variant": "error",
              "mode": "stroke"
            },
            "children": "Stroke"
          },
          {
            "component": "button",
            "props": {
              "variant": "error",
              "mode": "lighter"
            },
            "children": "Lighter"
          },
          {
            "component": "button",
            "props": {
              "variant": "error",
              "mode": "ghost"
            },
            "children": "Ghost"
          }
        ]
      },
      {
        "title": "Sizes",
        "description": "Buttons come in multiple sizes.",
        "code": "<Button.Root size=\"medium\">Medium</Button.Root>\n<Button.Root size=\"small\">Small</Button.Root>\n<Button.Root size=\"xsmall\">XSmall</Button.Root>\n<Button.Root size=\"xxsmall\">XXSmall</Button.Root>",
        "preview": [
          {
            "component": "button",
            "props": {
              "size": "medium"
            },
            "children": "Medium"
          },
          {
            "component": "button",
            "props": {
              "size": "small"
            },
            "children": "Small"
          },
          {
            "component": "button",
            "props": {
              "size": "xsmall"
            },
            "children": "XSmall"
          },
          {
            "component": "button",
            "props": {
              "size": "xxsmall"
            },
            "children": "XXSmall"
          }
        ]
      },
      {
        "title": "With Icons",
        "description": "Use Button.Icon to add icons to your button.",
        "code": "<Button.Root variant=\"primary\" mode=\"filled\">\n  <Button.Icon as={MailIcon} />\n  Send Email\n</Button.Root>"
      },
      {
        "title": "Icon Only",
        "description": "Set iconOnly to create square icon-only buttons.",
        "code": "<Button.Root variant=\"primary\" mode=\"filled\" iconOnly>\n  <Button.Icon as={PlusIcon} />\n</Button.Root>"
      }
    ],
    "api": [
      {
        "name": "Button.Root",
        "description": "The main button container component.",
        "props": [
          {
            "name": "variant",
            "type": "'primary' | 'neutral' | 'error'",
            "default": "'primary'",
            "description": "The color variant"
          },
          {
            "name": "mode",
            "type": "'filled' | 'stroke' | 'lighter' | 'ghost'",
            "default": "'filled'",
            "description": "The visual style"
          },
          {
            "name": "size",
            "type": "'medium' | 'small' | 'xsmall' | 'xxsmall'",
            "default": "'medium'",
            "description": "The size of the button"
          },
          {
            "name": "iconOnly",
            "type": "boolean",
            "default": "false",
            "description": "Makes the button square for icon-only use"
          },
          {
            "name": "asChild",
            "type": "boolean",
            "default": "false",
            "description": "Renders as child element instead of button"
          },
          {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the button"
          }
        ]
      },
      {
        "name": "Button.Icon",
        "description": "A wrapper for icons inside buttons.",
        "props": [
          {
            "name": "as",
            "type": "React.ElementType",
            "default": "'div'",
            "description": "The element or component to render"
          },
          {
            "name": "className",
            "type": "string",
            "description": "Additional CSS classes"
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/button.tsx",
      "type": "registry:ui"
    }
  ]
}
