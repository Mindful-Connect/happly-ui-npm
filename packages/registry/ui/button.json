        "title": "With Icons",
        "description": "You can embed icons directly in the button.",
        "code": "<Button variant=\"primary\" mode=\"filled\">\n  <MailIcon />\n  Send Email\n</Button>"
      }
    ],
    "api": [
      {
        "name": "Button",
        "description": "The main button component.",
        "props": [
          {
            "name": "variant",
            "type": "'primary' | 'neutral' | 'error' | 'success' | 'warning'",
            "default": "'primary'",
            "description": "The color variant"
          },
          {
            "name": "mode",
            "type": "'filled' | 'stroke' | 'lighter' | 'ghost'",
            "default": "'filled'",
            "description": "The visual style"
          },
          {
            "name": "size",
            "type": "'medium' | 'small' | 'xsmall' | 'xxsmall'",
            "default": "'medium'",
            "description": "The size of the button"
          },
          {
            "name": "asChild",
            "type": "boolean",
            "default": "false",
            "description": "Renders as child element instead of button"
          },
          {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the button"
          },
          {
            "name": "loading",
            "type": "boolean",
            "default": "false",
            "description": "Shows loading spinner"
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/button.tsx",
