{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "location-input",
  "type": "registry:ui",
  "title": "Location Input",
  "description": "A Google Maps address autocomplete input with Popover dropdown.",
  "version": "2.0.0",
  "migration": {
    "guide": "v2 replaces @headlessui/react with Radix Popover + Input primitives for consistent styling. Import changed from `{ LocationInput }` to `* as LocationInput` with `LocationInput.Root`. The `setLocation` prop is now `onLocationChange`. The `icon` prop accepts a React component (ElementType) instead of a ReactElement. New props: `size`, `hasError`, `disabled`, `countryRestrictions`, `apiKey`."
  },
  "dependencies": [
    "use-debounce",
    "@googlemaps/js-api-loader",
    "@remixicon/react",
    "@radix-ui/react-scroll-area",
    "react-remove-scroll"
  ],
  "registryDependencies": [
    "form-field-context",
    "popover",
    "input",
    "happly-ui-utils"
  ],
  "docs": {
    "lead": "A Google Maps address autocomplete input with async search and place resolution.",
    "usage": "import * as LocationInput from \"@/components/ui/location-input\"\n\n<LocationInput.Root location={location} onLocationChange={setLocation} />",
    "examples": [
      {
        "title": "Default",
        "description": "Default location input.",
        "code": "<LocationInput.Root location={location} onLocationChange={setLocation} />",
        "stories": ["Default"]
      }
    ],
    "api": [
      {
        "name": "LocationInput.Root",
        "description": "Google Maps address autocomplete input.",
        "props": [
          {
            "name": "location",
            "type": "LocationRequest",
            "description": "The current location object."
          },
          {
            "name": "onLocationChange",
            "type": "(location: LocationRequest) => void",
            "description": "Callback when location updates."
          },
          {
            "name": "placeholder",
            "type": "string",
            "default": "'Search address...'",
            "description": "Input placeholder text."
          },
          {
            "name": "icon",
            "type": "React.ElementType",
            "default": "RiMapPinLine",
            "description": "Leading icon component."
          },
          {
            "name": "size",
            "type": "'medium' | 'small' | 'xsmall'",
            "default": "'medium'",
            "description": "Input size variant."
          },
          {
            "name": "hasError",
            "type": "boolean",
            "default": "false",
            "description": "Error state."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disabled state."
          },
          {
            "name": "countryRestrictions",
            "type": "string[]",
            "default": "['ca', 'us', 'fr']",
            "description": "ISO 3166-1 alpha-2 country codes for autocomplete."
          },
          {
            "name": "apiKey",
            "type": "string",
            "description": "Google Maps API key. Defaults to NEXT_PUBLIC_GOOGLE_API_KEY."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/location-input.tsx",
      "type": "registry:ui"
    }
  ]
}
