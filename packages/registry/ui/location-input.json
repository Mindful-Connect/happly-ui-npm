{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "location-input",
  "type": "registry:ui",
  "title": "Location Input",
  "description": "A Google Maps address autocomplete input.",
  "dependencies": [
    "use-debounce",
    "@googlemaps/js-api-loader",
    "@headlessui/react"
  ],
  "registryDependencies": ["utils"],
  "docs": {
    "lead": "A Google Maps address autocomplete input.",
    "usage": "import { LocationInput } from \"@/components/ui/location-input\"\n\n<LocationInput location={location} setLocation={setLocation} />",
    "examples": [
      {
        "title": "Default",
        "description": "Default location input.",
        "code": "import { LocationInput } from \"@/components/ui/location-input\"\nimport { useState } from \"react\"\n\nexport function DemoLocationInput() {\n  const [location, setLocation] = useState<any>(null)\n\n  return (\n    <LocationInput\n      location={location}\n      setLocation={setLocation}\n    />\n  )\n}",
        "preview": [
          {
            "component": "location-input",
            "props": {}
          }
        ]
      }
    ],
    "api": [
      {
        "name": "LocationInput",
        "description": "The LocationInput component.",
        "props": [
          {
            "name": "location",
            "type": "LocationRequest",
            "description": "The current location object."
          },
          {
            "name": "setLocation",
            "type": "(location: LocationRequest) => void",
            "description": "Callback when location updates."
          },
          {
            "name": "placeholder",
            "type": "string",
            "default": "\"Select a location...\"",
            "description": "Input placeholder text."
          },
          {
            "name": "icon",
            "type": "ReactElement<SVGProps<SVGSVGElement>>",
            "description": "Optional icon to display."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/location-input.tsx",
      "type": "registry:ui"
    }
  ]
}
