{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "phone-input",
  "type": "registry:ui",
  "title": "Phone Input",
  "description": "A phone input component with country selection and formatting.",
  "dependencies": [
    "react-international-phone",
    "libphonenumber-js",
    "merge-refs"
  ],
  "registryDependencies": [
    "form-field-context",
    "use-form-field-binding",
    "input",
    "select",
    "use-formatted-caret"
  ],
  "docs": {
    "lead": "A phone input component with country selection and automatic formatting.",
    "usage": "import * as PhoneInput from \"@/components/ui/phone-input\"\n\n<PhoneInput.Root onValueChange={(e164) => console.log(e164)} />",
    "examples": [
      {
        "title": "Default",
        "description": "Phone input with default country (Canada).",
        "code": "<PhoneInput.Root onValueChange={(e164) => console.log(e164)} />",
        "stories": ["Default"]
      },
      {
        "title": "Controlled",
        "description": "Fully controlled phone input with value and country.",
        "code": "<PhoneInput.Root\n  value={value}\n  onValueChange={setValue}\n  country={country}\n  onCountryChange={setCountry}\n/>",
        "stories": ["Controlled"]
      },
      {
        "title": "Sizes",
        "description": "All three input sizes: medium (default), small, and xsmall.",
        "code": "<PhoneInput.Root size=\"medium\" />\n<PhoneInput.Root size=\"small\" />\n<PhoneInput.Root size=\"xsmall\" />",
        "stories": ["Sizes"]
      },
      {
        "title": "Error State",
        "description": "Phone input in error state.",
        "code": "<PhoneInput.Root hasError />",
        "stories": ["ErrorState"]
      },
      {
        "title": "Disabled",
        "description": "Phone input in disabled state.",
        "code": "<PhoneInput.Root disabled />",
        "stories": ["Disabled"]
      },
      {
        "title": "With Form Field",
        "description": "Phone input composed with FormField for consistent label and hint.",
        "code": "<FormField.Root\n  label=\"Phone Number\"\n  htmlFor=\"phone\"\n  required\n  hint=\"Enter your phone number.\"\n>\n  <PhoneInput.Root id=\"phone\" />\n</FormField.Root>",
        "stories": ["WithFormField"]
      }
    ],
    "api": [
      {
        "name": "PhoneInput.Root",
        "description": "The composed phone input component. Forwards ref to the underlying input element.",
        "props": [
          {
            "name": "value",
            "type": "string",
            "description": "Phone value in E.164 format (controlled)."
          },
          {
            "name": "onValueChange",
            "type": "(e164: string) => void",
            "description": "Callback when value changes."
          },
          {
            "name": "country",
            "type": "CountryIso2",
            "description": "Controlled country ISO2 code."
          },
          {
            "name": "defaultCountry",
            "type": "CountryIso2",
            "default": "'ca'",
            "description": "Default country to select."
          },
          {
            "name": "onCountryChange",
            "type": "(iso2: CountryIso2) => void",
            "description": "Callback when country changes."
          },
          {
            "name": "preferredCountries",
            "type": "CountryIso2[]",
            "default": "['ca', 'us', 'fr']",
            "description": "Countries shown at the top of the dropdown."
          },
          {
            "name": "size",
            "type": "'medium' | 'small' | 'xsmall'",
            "default": "'medium'",
            "description": "Size variant."
          },
          {
            "name": "hasError",
            "type": "boolean",
            "description": "Whether the input has an error state."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "description": "Whether the input is disabled."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/phone-input.tsx",
      "type": "registry:ui"
    }
  ]
}
