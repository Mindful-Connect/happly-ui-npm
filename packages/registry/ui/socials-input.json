{
  "$schema": "https://cdn.jsdelivr.net/gh/Mindful-Connect/happly-ui-npm@production/schemas/registry-item.json",
  "name": "socials-input",
  "type": "registry:ui",
  "title": "Socials Input",
  "description": "A dynamic input list for social media URLs with validation and icons.",
  "dependencies": [
    "zod",
    "@headlessui/react",
    "react-icons",
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": ["utils", "input"],
  "docs": {
    "lead": "A dynamic input list for social media URLs with validation and icons.",
    "usage": "import SocialsInput from \"@/components/ui/socials-input\"\n\n<SocialsInput\n  name=\"socials\"\n  formValue={values}\n  setFormValue={setValues}\n/>",
    "examples": [
      {
        "title": "Default",
        "description": "Default usage with English labels.",
        "code": "<SocialsInput\n  name=\"socials\"\n  formValue={values}\n  setFormValue={setValues}\n/>",
        "preview": [{ "component": "socials-input", "props": {} }]
      }
    ],
    "api": [
      {
        "name": "SocialsInput",
        "description": "The main component.",
        "props": [
          {
            "name": "formValue",
            "type": "Record<string, string>",
            "default": "{}",
            "description": "The current state of social inputs."
          },
          {
            "name": "setFormValue",
            "type": "(value: Record<string, string>) => void",
            "description": "State setter."
          },
          {
            "name": "labels",
            "type": "Partial<SocialsInputLabels>",
            "description": "Optional labels for translation."
          }
        ]
      }
    ]
  },
  "files": [
    {
      "path": "ui/socials-input.tsx",
      "type": "registry:ui"
    }
  ]
}
